{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/shop",
      "destination": "/shop/",
      "permanent": false
    },
    {
      "source": "/shop/index.html",
      "destination": "/shop/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/shop/#account",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/shop/#account",
      "permanent": false
    },
    {
      "source": "/admin/index.html",
      "destination": "/shop/#account",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__migration",
      "destination": "/api/migrate"
    },
    {
      "source": "/shop/catalogue.js",
      "destination": "/api/gateway?resource=catalogue"
    },
    {
      "source": "/media/:id",
      "destination": "/api/gateway?resource=media&id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?resource=api&path=:path"
    },
    {
      "source": "/after-hours",
      "destination": "/after-hours/index.html"
    },
    {
      "source": "/after-hours/",
      "destination": "/after-hours/index.html"
    }
  ],
  "regions": [
    "syd1"
  ],
  "functions": {
    "api/*.mjs": {
      "includeFiles": "dist/server/**",
      "maxDuration": 60
    }
  }
}
